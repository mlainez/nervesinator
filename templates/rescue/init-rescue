#!/bin/sh
# /init of the rescue initramfs: RAM-only system with USB networking and ssh.
# Phone: 10.0.42.1, computer: 10.0.42.2 (handed out by unudhcpd).
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /run /tmp /sys/kernel/config /sys/fs/pstore
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t configfs configfs /sys/kernel/config 2>/dev/null
mount -t pstore pstore /sys/fs/pstore 2>/dev/null
hostname rescue
ip link set lo up

echo "rescue: starting USB networking" >/dev/tty0
/usr/sbin/usb-gadget.sh >/dev/tty0 2>&1

# ssh (dropbear) if present, telnetd as a fallback
if command -v dropbear >/dev/null; then
  mkdir -p /etc/dropbear
  dropbear -R -B
elif command -v telnetd >/dev/null; then
  telnetd -l /bin/sh
fi

# Previous kernel's last words (warm reboot after a crash)
if ls /sys/fs/pstore/* >/dev/null 2>&1; then
  echo "rescue: pstore has logs from the previous boot: /sys/fs/pstore" >/dev/tty0
fi

echo "rescue: ready, ssh root@10.0.42.1" >/dev/tty0
# Keep a shell on the screen console too, and never let PID 1 exit.
while true; do
  setsid sh -c 'exec sh </dev/tty0 >/dev/tty0 2>&1' 2>/dev/null || sh </dev/tty0 >/dev/tty0 2>&1
  sleep 1
done
