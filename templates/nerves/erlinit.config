# erlinit.config skeleton for an Android device. Adapt the device paths to the A/B layout decision.
-v
# Console on the screen (tty1) or a USB serial gadget (ttyGS0)
--ctty tty1
--hostname-pattern nerves-%s
--pre-run-exec /usr/bin/nbtty
# Application data partition (f2fs), path as seen after the initramfs mapped the sub-image
-m /dev/REPLACE_ME:/root:f2fs:nodev:
-m tmpfs:/sys/fs/cgroup:tmpfs:nodev,noexec,nosuid:mode=755,size=1024k
--shutdown-report /root/shutdown.txt
